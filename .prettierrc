{
  "singleQuote": true,
  "printWidth": 100,
  "semi": false,
  "tabWidth": 2,
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/index.css",
  "importOrder": [
    "^react$",
    "^jotai$",
    "^@tanstack/(.*)$",
    "^react-i18next$",
    ".*styles.css$",
    "",
    "^@docs/(.*)$",
    "<BUILTIN_MODULES>",
    "<THIRD_PARTY_MODULES>",
    "^@/.*$",
    "^../(?!.*.css$).*$",
    "^./(?!.*.css$).*$",
    "\\.css$"
  ],
  "overrides": [
    {
      "files": "*.mdx",
      "options": {
        "printWidth": 70
      }
    }
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
