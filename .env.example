# API 서버 base URL (미설정 시 apiClient는 동일 출처 '/api'로 폴백)
# 로컬 Go(oc-api-go): http://localhost:8090/api/v1   ← 현재 정본 (docs/api/go/)
# 로컬 Laravel(구):   http://localhost:8000/api/v1
VITE_API_URL=

# 자료실 다운로드용 S3/CDN 공개 주소 (끝에 슬래시 포함). 미설정 시 다운로드 버튼 비활성.
# 로컬: http://localhost:9100/officewave-uploads/   운영: CloudFront 주소
VITE_S3_FILE_BASE_URL=
# 게시글 첨부 다운로드용 S3/CDN 공개 주소 (끝에 슬래시 포함). 미설정 시 다운로드 버튼 비활성.
# ⚠️ 자료실과 다른 버킷이다 — API 의 CDN_URL 값(자료실은 CDN_DRIVE_URL).
VITE_S3_POST_BASE_URL=
