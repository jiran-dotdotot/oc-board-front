# Claude Code per-developer / per-machine config (must NOT be committed)
.claude/settings.local.json
# .mcp.json is intentionally NOT ignored (M8): the shadcn entry is just a public `npx` command,
# safe to commit + share. Uncomment ONLY if you add a server with secrets or machine-specific paths:
# .mcp.json

# Husky generated shims (regenerated by the `prepare: husky` npm script)
.husky/_/

# Claude Code runtime working dirs (if you use these tools)
.superpowers/
.omc/

# Note: KEEP these tracked (do NOT ignore) — they are the shared setup:
#   .claude/settings.json   .claude/hooks/
#   .husky/pre-commit  .husky/pre-push
#   CLAUDE.md  components.json  .prettierrc  eslint.config.js  vitest.config.ts  playwright.config.ts
#   .npmrc  .nvmrc  .mcp.json (public shadcn server)

# Test / coverage output (generated)
coverage
playwright-report
test-results

# Local env files (keep .env.example tracked)
.env
.env.*
!.env.example
